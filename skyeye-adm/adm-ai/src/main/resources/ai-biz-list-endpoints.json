{
  "version": 1,
  "docs": {
    "说明": "biz_list 工具的列表接入配置。优先：平台信息设置 → AI业务列表（settingData.ai.bizListEndpoints）；未配或空数组时用本文件。标准 JSON 不支持 // 注释，故用 docs 字段说明。",
    "路由": "二选一：springApplicationName（直接 Discovery，可写 skyeye-erp）或 appId+serviceClassName（查 ServiceBean，须为已注册的 SkyeyeBusinessService）。domain 不是微服务名。",
    "索引键": "domain + type + variant（默认 default；商城传了 storeId 时用 store）",
    "字段": {
      "domain": "业务域，给大模型选：oa / erp / mall（shop 会归一成 mall）",
      "type": "列表类型，工具入参 type，如 pending、depotOut、waitPay",
      "aliases": "可选。type 别名，如 waitDepotOut、E01 也能命中同一条",
      "listTitle": "返回给前端/模型的列表卡片标题",
      "scope": "可选。结果里的 scope 说明，默认等于 domain",
      "appId": "可选，可空字符串。与业务对象 ServiceBean 的 appId 一致",
      "springApplicationName": "可选。Nacos 服务名前缀如 skyeye-erp；有则跳过 ServiceBean",
      "serviceClassName": "无 springApplicationName 时必填。须已注册到 ServiceBean 的类全限定名",
      "apiId": "必填。远程接口短 id，如 activitimode008、queryDepotOutList（禁止含斜杠）",
      "variant": "default | store。有门店 id 查门店列表时用 store",
      "requireStoreId": "可选 bool。true 时必须传 storeId",
      "fixedParams": "可选。每次请求固定附带的参数，如 {\"type\":\"AllWait\"}",
      "typeParamMap": "可选。把工具 type 映射成接口 type 码，如 {\"waitPay\":\"1\"}",
      "typeParamKey": "可选。写入请求的 type 字段名，默认 type",
      "argBindings": "可选。工具入参映射到请求字段，如 {\"storeId\":\"objectId\"}",
      "fields": {
        "titlePaths": "行数据里取卡片标题的候选路径（按顺序取第一个非空）",
        "subtitle": "副标题配置数组：{label?, paths:[...]}",
        "idPaths": "取业务 id 的候选路径"
      }
    },
    "示例": {
      "domain": "erp",
      "type": "depotOut",
      "listTitle": "待出库单据",
      "appId": "",
      "serviceClassName": "com.skyeye.depot.service.impl.DepotOutServiceImpl",
      "apiId": "queryDepotOutList",
      "variant": "default"
    },
    "界面配置": "云平台 → 系统 → 平台基础信息 →「AI业务列表」Tab；可加载内置默认后编辑保存。",
    "注意_Flowable": "ActivitiTaskServiceImpl 无 @SkyeyeService，不能用于路由；审批类接口请用同微服务上已注册的 ActUserProcessServiceImpl（仅解析 URI，apiId 仍指向 activitimode*）。"
  },
  "endpoints": [
